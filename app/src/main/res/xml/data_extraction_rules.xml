<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
  INERT while allowBackup="false" in the manifest. Kept, not deleted, so that
  turning automatic backup back on is a one-attribute change with the scope
  already decided rather than a rule set to rewrite under pressure.
 Android auto-backup: the teacher's register survives a phone upgrade.
         This is one half of "backup is the account" (onboarding-and-auth.md);
         the manual export is the other, and the one he can actually see. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
