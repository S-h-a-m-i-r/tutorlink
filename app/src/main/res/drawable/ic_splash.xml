<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Self-contained: the teal disc is part of the drawable rather than relying on
      windowSplashScreenIconBackgroundColor, which did not apply and left white
      bars invisible on the pale splash ground.

      A plain vector passed to windowSplashScreenAnimatedIcon is NOT circle-masked
      by the system (only AdaptiveIconDrawables are), so the disc has to be drawn.
    -->
    <path
        android:pathData="M54,4a50,50 0 1,0 0.1,0z"
        android:fillColor="#2C7383" />

    <path
        android:pathData="M31,65 L31,71"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="12"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,53 L54,71"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.78"
        android:strokeWidth="12"
        android:strokeLineCap="round" />
    <path
        android:pathData="M77,37 L77,71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round" />
</vector>
