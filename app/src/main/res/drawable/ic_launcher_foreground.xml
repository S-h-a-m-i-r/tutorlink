    <!--
      An inkpot with a quill: the app's name, drawn. Name-independent of any
      one feature, so it survives the app growing past fees.

      Adaptive icons are masked to a ~72dp circle inside a 108dp canvas, so every
      point sits within 33 of the centre (54,54): the quill tip is at 32.2, the
      pot's lower corners at 30.

      The quill is drawn first so the pot covers its base: it reads as standing
      in the ink. The spine is the only non-white stroke; in a monochrome
      (themed) icon it simply merges into the feather.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53,48 Q51.5,30 70,25 Q69.5,42.5 53,48 Z" />
    <path
        android:pathData="M55.5,45 L68.5,27.5"
        android:strokeColor="#2C7383"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
